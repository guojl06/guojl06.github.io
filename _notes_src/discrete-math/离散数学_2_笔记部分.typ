  columns: (1fr, 1fr, 1fr),
  fill: (x, y) => if y == 0 { gray.lighten(60%) },
  [*代号*], [*课程名称*], [*先修课程*],
  [C1], [高等数学], [无],
  [C2], [程序设计], [无],
  [C3], [离散数学], [C1],
  [C4], [数据结构], [C2, C3],
  [C5], [编译原理], [C2, C4],
  [C6], [操作系统], [C4, C7],
